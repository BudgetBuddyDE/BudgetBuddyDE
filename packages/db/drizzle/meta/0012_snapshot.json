      "columns": {
        "owner_id": {
          "name": "owner_id",
          "type": "varchar",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select EXTRACT(MONTH FROM \"processed_at\") as \"month\", EXTRACT(YEAR FROM \"processed_at\") as \"year\", (DATE_TRUNC('month', \"processed_at\") + INTERVAL '1 month - 1 day')::DATE as \"date\", \"owner_id\", SUM(CASE WHEN \"transfer_amount\" > 0 THEN \"transfer_amount\" ELSE 0 END) as \"income\", SUM(CASE WHEN \"transfer_amount\" < 0 THEN ABS(\"transfer_amount\") ELSE 0 END) as \"expenses\", SUM(\"transfer_amount\") as \"balance\" from \"budgetbuddy_backend\".\"transaction\" group by EXTRACT(MONTH FROM \"budgetbuddy_backend\".\"transaction\".\"processed_at\"), EXTRACT(YEAR FROM \"budgetbuddy_backend\".\"transaction\".\"processed_at\"), (DATE_TRUNC('month', \"budgetbuddy_backend\".\"transaction\".\"processed_at\") + INTERVAL '1 month - 1 day')::DATE, \"budgetbuddy_backend\".\"transaction\".\"owner_id\"",
      "materialized": false,
      "isExisting": false
    },
