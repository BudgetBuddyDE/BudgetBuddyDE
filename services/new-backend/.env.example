# Required for authentication; PostgreSQL is also required for readiness.
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/mydatabase
# Use the existing backend secret to preserve signed sessions.
AUTH_SECRET=
RESEND_API_KEY=

# Required in production; defaults shown for other environments.
BASE_URL=http://localhost:9100
TRUSTED_ORIGINS=http://localhost:3000

# Required for readiness, but not for starting the server. Database index defaults to 1.
REDIS_URL=redis://:mycachepassword@localhost:6379
REDIS_DB=1

# Optional auth Redis; omit the URL to use PostgreSQL sessions. Database index defaults to 0.
AUTH_REDIS_URL=redis://:mycachepassword@localhost:6379
AUTH_REDIS_DB=0

# Optional. Configure both values to enable an OAuth provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISABLE_SIGNUP=false
# NODE_ENV=development
LOG_LEVEL=info
