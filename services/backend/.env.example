# Required: the same PostgreSQL database contains auth and domain schemas
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/mydatabase
AUTH_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
TRUSTED_ORIGINS=http://localhost:3000

# Required in production: complete public HTTP(S) backend origin without path/query
# Outside production, omitted BASE_URL defaults to http://localhost:<PORT>
BASE_URL=http://localhost:9000

# Optional GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional auth sessions: independent of response-cache Redis
# Preserve the previous auth Redis URL/database when migrating existing sessions
# Without AUTH_REDIS_URL, sessions are stored in PostgreSQL
#AUTH_REDIS_URL=redis://:mycachepassword@localhost:6379
#AUTH_REDIS_DB=0

# Optional response cache and domain rate limiting
REDIS_URL=redis://:mycachepassword@localhost:6379
#REDIS_DB=1

# Optional authentication flags
#DISABLE_SIGNUP=false
#DISABLE_CSRF_CHECK=false

# Attachments: configure all five values together
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional
#PORT=9000
#TRUST_PROXY=1
LOG_LEVEL=DEBUG
LOG_HIDE_META=false
TIMEZONE=Europe/Berlin

# Tracing (OpenTelemetry): only used with npm run start:instrumentation
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
