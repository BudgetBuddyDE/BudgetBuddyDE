{
  "name": "@budgetbuddyde/webapp",
  "version": "3.5.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pretest": "npm run check",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint:check",
    "typecheck": "tsc --noEmit",
    "check:write": "npm run lint && npm run format",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:check": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "post-update": "echo \"codesandbox preview only, need an update\" && pnpm update --latest"
  },
  "dependencies": {
    "@better-auth/api-key": "1.5.6",
    "@budgetbuddyde/api": "*",
    "@budgetbuddyde/core": "0.1.0",
    "@budgetbuddyde/logger": "0.1.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-charts": "^8.29.3",
    "@mui/x-data-grid": "^8.29.3",
    "@mui/x-date-pickers": "^8.29.3",
    "@reduxjs/toolkit": "^2.8.2",
    "assert": "^2.1.0",
    "better-auth": "1.5.6",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "lodash.debounce": "^4.0.8",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.62.0",
    "react-redux": "^9.2.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/lodash.debounce": "^4.0.8",
    "@types/node": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "latest",
    "eslint-config-next": "^16.3.4",
    "happy-dom": "^20.8.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
