{
  "name": "@budgetbuddyde/charts",
  "version": "0.1.0",
  "private": true,
  "description": "Recharts-based chart components for BudgetBuddyDE finance visualizations.",
  "keywords": [
    "charts",
    "recharts",
    "finance",
    "visualization"
  ],
  "author": "Thorben",
  "license": "MIT",
  "homepage": "https://github.com/BudgetBuddyDE/BudgetBuddyDE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BudgetBuddyDE/BudgetBuddyDE.git"
  },
  "bugs": {
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE/issues"
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "pretest": "pnpm run check",
    "test": "vp test run --silent",
    "test:watch": "vp test",
    "check": "pnpm run format:check && pnpm run lint:check",
    "check:write": "pnpm run lint && pnpm run format",
    "lint": "vp lint src --fix --max-warnings=0",
    "lint:check": "vp lint src --max-warnings=0",
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "vp fmt --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "recharts": "^3.10.1"
  },
  "peerDependencies": {
    "@mui/material": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mui/material": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "vite-plus": "1.3.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./primitives": {
      "dev-source": "./src/primitives/index.ts",
      "types": "./lib/primitives/index.d.ts",
      "default": "./lib/primitives/index.js"
    },
    "./theme": {
      "dev-source": "./src/theme/index.ts",
      "types": "./lib/theme/index.d.ts",
      "default": "./lib/theme/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./lib/index.d.ts"
      ],
      "primitives": [
        "./lib/primitives/index.d.ts"
      ],
      "theme": [
        "./lib/theme/index.d.ts"
      ]
    }
  }
}
