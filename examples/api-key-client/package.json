{
  "name": "@budgetbuddyde/example-api-key-client",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Node.js TypeScript example for using @budgetbuddyde/api with an API key.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "rimraf lib && tsc",
    "pretest": "npm run check",
    "test": "vp test run --silent",
    "test:watch": "vp test",
    "check": "npm run format:check && npm run lint:check",
    "check:write": "npm run lint && npm run format",
    "lint": "vp lint src --fix --max-warnings=0",
    "lint:check": "vp lint src --max-warnings=0",
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "vp fmt --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\"",
    "start": "node lib/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@budgetbuddyde/api": "*",
    "@budgetbuddyde/core": "0.1.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "vite-plus": "1.3.0"
  }
}
