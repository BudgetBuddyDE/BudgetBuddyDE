{
  "name": "budgetbuddyde",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev-services": "turbo run dev --filter=./services/*",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint && vp lint vite.config.ts vite.shared.ts --fix --max-warnings=0",
    "lint:check": "turbo run lint:check && vp lint vite.config.ts vite.shared.ts --max-warnings=0",
    "check": "turbo run check",
    "check:write": "turbo run check:write",
    "test": "turbo run test",
    "build": "turbo run build",
    "build-packages": "turbo run build --filter=./packages/*",
    "build-services": "turbo run build --filter=./services/*",
    "build-apps": "turbo run build --filter=./apps/*",
    "build-examples": "turbo run build --filter='./examples/*'",
    "typecheck": "turbo run typecheck",
    "ci": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck && pnpm run test:ci-contracts && pnpm test && pnpm run build",
    "test:ci-contracts": "node --test ci/tests/*.test.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
