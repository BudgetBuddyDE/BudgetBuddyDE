{
  "name": "budgetbuddyde",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "overrides": {
    "waku": "1.0.0-rc.1"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/webapp",
    "apps/documentation",
    "examples/*"
  ],
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev-services": "turbo run dev --filter=./services/*",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint && eslint vitest.config.ts ci/tests/*.mjs --fix --max-warnings=0",
    "lint:check": "turbo run lint:check && eslint vitest.config.ts ci/tests/*.mjs --max-warnings=0",
    "check": "turbo run check",
    "check:write": "turbo run check:write",
    "test": "turbo run test",
    "build": "turbo run build",
    "build-packages": "turbo run build --filter=./packages/*",
    "build-services": "turbo run build --filter=./services/*",
    "build-apps": "turbo run build --filter=./apps/*",
    "build-examples": "turbo run build --filter='./examples/*'",
    "typecheck": "turbo run typecheck",
    "ci": "npm run format:check && npm run lint:check && npm run typecheck && npm run test:ci-contracts && npm test && npm run build",
    "test:ci-contracts": "node --test ci/tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "turbo": "^2.9.14",
    "typescript-eslint": "^8.61.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
