{
  "name": "@budgetbuddyde/db",
  "version": "0.3.0",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "Thorben",
  "license": "MIT",
  "homepage": "https://github.com/BudgetBuddyDE/BudgetBuddyDE",
  "repository": {
    "type": "git",
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE.git"
  },
  "bugs": {
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE/issues"
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "pretest": "pnpm run check",
    "test": "vp test run --silent",
    "test:watch": "vp test",
    "check": "pnpm run format:check && pnpm run lint:check",
    "check:write": "pnpm run lint && pnpm run format",
    "lint": "vp lint src --fix --max-warnings=0",
    "lint:check": "vp lint src --max-warnings=0",
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "vp fmt --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "ba:schema-generate": "pnpm dlx @better-auth/cli generate --output src/auth/tables.ts -y",
    "db:full-generate": "pnpm run ba:schema-generate && pnpm exec drizzle-kit generate",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec drizzle-kit migrate",
    "db:studio": "pnpm exec drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "@types/node": "^24.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "vite-plus": "1.3.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./backend": {
      "dev-source": "./src/backend/index.ts",
      "types": "./lib/backend/index.d.ts",
      "default": "./lib/backend/index.js"
    },
    "./auth": {
      "dev-source": "./src/auth/index.ts",
      "types": "./lib/auth/index.d.ts",
      "default": "./lib/auth/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./lib/index.d.js"
      ],
      "backend": [
        "./lib/backend/index.d.ts"
      ],
      "auth": [
        "./lib/auth/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@budgetbuddyde/core": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "uuidv7": "^1.1.0"
  }
}
