{
  "name": "@budgetbuddyde/logger",
  "version": "0.1.1",
  "description": "Runtime-neutral structured logging facade for BudgetBuddyDE.",
  "keywords": [
    "logger.js",
    "logging",
    "utility"
  ],
  "author": "Thorben Klein",
  "license": "MIT",
  "homepage": "https://github.com/budgetbuddyde/logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budgetbuddyde/logger.git"
  },
  "bugs": {
    "url": "https://github.com/budgetbuddyde/logger/issues"
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "pretest": "pnpm run check",
    "test": "vp test run --silent",
    "test:watch": "vp test",
    "check": "pnpm run format:check && pnpm run lint:check",
    "check:write": "pnpm run lint && pnpm run format",
    "lint": "vp lint src --fix --max-warnings=0",
    "lint:check": "vp lint src --max-warnings=0",
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "vp fmt --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "5.0.5",
    "vite-plus": "1.4.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./console": {
      "dev-source": "./src/console.ts",
      "types": "./lib/console.d.ts",
      "default": "./lib/console.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./lib/index.d.ts"
      ],
      "console": [
        "./lib/console.d.ts"
      ]
    }
  },
  "private": true
}
