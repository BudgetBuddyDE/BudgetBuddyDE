{
  "name": "@budgetbuddyde/example-api-key-client",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Node.js TypeScript example for using @budgetbuddyde/api with an API key.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "rimraf lib && tsc",
    "pretest": "pnpm run check",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "pnpm run format:check && pnpm run lint:check",
    "check:write": "pnpm run lint && pnpm run format",
    "lint": "vp lint src --fix --max-warnings=0",
    "lint:check": "vp lint src --max-warnings=0",
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "vp fmt --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\"",
    "start": "node lib/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@budgetbuddyde/api": "workspace:*",
    "@budgetbuddyde/core": "workspace:*",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "5.1.1",
    "vite-plus": "1.7.0"
  }
}
