# Required
# Direct backend URL:
BUDGETBUDDY_BACKEND_URL=http://localhost:9000
# Set to 1 when this service is reached through one trusted Traefik proxy.
TRUST_PROXY_HOPS=0

# The gateway URL is equivalent. The MCP client automatically appends /api/*.
# BUDGETBUDDY_BACKEND_URL=https://prod.gateway.domain.de/backend/v1

# Optional
#PORT=8070
#NODE_ENV=development
#LOG_LEVEL=info
