{
  "name": "@budgetbuddyde/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration, environment, and error primitives for BudgetBuddyDE.",
  "keywords": [
    "configuration",
    "environment",
    "errors"
  ],
  "author": "Thorben",
  "license": "MIT",
  "homepage": "https://github.com/BudgetBuddyDE/BudgetBuddyDE",
  "repository": {
    "type": "git",
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE.git"
  },
  "bugs": {
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./config": {
      "dev-source": "./src/config.ts",
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./error": {
      "dev-source": "./src/error.ts",
      "types": "./lib/error.d.ts",
      "default": "./lib/error.js"
    },
    "./environment": {
      "dev-source": "./src/environmentVariable.ts",
      "types": "./lib/environmentVariable.d.ts",
      "default": "./lib/environmentVariable.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./lib/index.d.ts"
      ],
      "config": [
        "./lib/config.d.ts"
      ],
      "error": [
        "./lib/error.d.ts"
      ],
      "environment": [
        "./lib/environmentVariable.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "pretest": "npm run check",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint:check",
    "check:write": "npm run lint && npm run format",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:check": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
