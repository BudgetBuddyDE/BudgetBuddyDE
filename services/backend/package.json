{
  "name": "@budgetbuddyde/backend",
  "version": "0.5.1",
  "main": "build/src/server.js",
  "scripts": {
    "start": "node --require ./build/src/instrumentation.js build/src/server.js",
    "start:instrumentation": "pnpm run build && pnpm run start",
    "dev": "tsx watch src/server.ts",
    "build": "pnpm exec rimraf build && pnpm exec tsc",
    "pretest": "pnpm run check",
    "test": "vp test run --coverage",
    "check": "pnpm run format:check && pnpm run lint:check",
    "check:write": "pnpm run lint && pnpm run format",
    "lint": "vp lint src --fix --max-warnings=0",
    "lint:check": "vp lint src --max-warnings=0",
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "vp fmt --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budgetbuddyde/budgetbuddyde.git"
  },
  "author": "Thorben Klein",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/budgetbuddyde/budgetbuddyde/issues"
  },
  "homepage": "https://github.com/budgetbuddyde/budgetbuddyde#readme",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@better-auth/api-key": "1.5.6",
    "@budgetbuddyde/api": "workspace:*",
    "@budgetbuddyde/core": "workspace:*",
    "@budgetbuddyde/db": "workspace:*",
    "@budgetbuddyde/logger": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "better-auth": "1.5.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-zod-safe": "^3.1.0",
    "ioredis": "^5.8.2",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "pg": "^8.23.1",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.35.0",
    "sharp": "^0.35.5",
    "uuidv7": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  }
}
