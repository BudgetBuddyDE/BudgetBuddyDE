{
  "name": "@budgetbuddyde/cli",
  "version": "1.0.0",
  "private": true,
  "description": "Command-line interface for BudgetBuddyDE",
  "author": "BudgetBuddyDE",
  "license": "MIT",
  "homepage": "https://github.com/BudgetBuddyDE/BudgetBuddyDE",
  "repository": {
    "type": "git",
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "budgetbuddy": "bin/run.js"
  },
  "files": [
    "/bin",
    "/lib"
  ],
  "oclif": {
    "bin": "budgetbuddy",
    "dirname": "budgetbuddy",
    "commands": "./lib/commands",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "dev": "bin/dev.js",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:check": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint:check",
    "check:write": "npm run lint && npm run format",
    "test": "vitest run --silent"
  },
  "dependencies": {
    "@oclif/core": "^4.13.5",
    "figlet": "^1.9.2",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
