{
  "name": "@budgetbuddyde/mcp-cli",
  "version": "1.0.0",
  "description": "A complete TypeScript example CLI built with oclif.",
  "author": "",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "bin",
    "lib/commands",
    "lib/hooks",
    "lib/index.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "budgetbuddyde-mcp": "bin/run.js"
  },
  "oclif": {
    "bin": "budgetbuddyde-mcp",
    "dirname": "budgetbuddyde-mcp",
    "commands": "./lib/commands",
    "hooks": {
      "init": "./lib/hooks/init"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "node bin/dev.js",
    "lint": "tsc --noEmit",
    "test": "npm run build && mocha --require ts-node/register --require source-map-support/register \"test/**/*.test.ts\"",
    "pack:dry-run": "npm run build && npm publish --dry-run"
  },
  "dependencies": {
    "@budgetbuddyde/api": "*",
    "@budgetbuddyde/utils": "^1.3.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oclif/core": "^4.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "figlet": "^1.8.0",
    "kleur": "^4.1.5",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oclif/test": "^4.0.0",
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/figlet": "^1.5.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
