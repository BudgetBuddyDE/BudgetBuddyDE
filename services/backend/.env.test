NODE_ENV=test
DATABASE_URL=postgresql://test:test@localhost:5432/budgetbuddy_backend_test
REDIS_URL=redis://localhost:6379
# Deterministic object-storage settings for test infrastructure.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_S3_BUCKET_NAME=budgetbuddy-test
AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
# Keep security-relevant configuration deterministic when a developer .env exists.
DISABLE_CSRF_CHECK=false
DISABLE_SIGNUP=false
TRUSTED_ORIGINS=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
