{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ES2022",
    "module": "CommonJS",
    // Vite+ re-exports Vitest; retain CommonJS resolution without changing emitted application imports.
    "paths": {"vite-plus/test": ["../../node_modules/vitest"]},
    "moduleDetection": "force",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,

    "forceConsistentCasingInFileNames": true,
    "noPropertyAccessFromIndexSignature": false,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "outDir": "./build",
    "types": ["node", "vitest/globals", "express", "multer"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/build/**", "./vitest.config.ts", "../../vite.config.ts", "../../vite.shared.ts"]
}
