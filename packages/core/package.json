{
  "name": "@budgetbuddyde/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration, environment, and error primitives for BudgetBuddyDE.",
  "keywords": [
    "configuration",
    "environment",
    "errors"
  ],
  "author": "Thorben",
  "license": "MIT",
  "homepage": "https://github.com/BudgetBuddyDE/BudgetBuddyDE",
  "repository": {
    "type": "git",
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE.git"
  },
  "bugs": {
    "url": "https://github.com/BudgetBuddyDE/BudgetBuddyDE/issues"
  },
  "exports": {
    "./config/Config": {
      "dev-source": "./src/config/Config.ts",
      "types": "./lib/config/Config.d.ts",
      "default": "./lib/config/Config.js"
    },
    "./config/BackendConfig": {
      "dev-source": "./src/config/BackendConfig.ts",
      "types": "./lib/config/BackendConfig.d.ts",
      "default": "./lib/config/BackendConfig.js"
    },
    "./error/ApiClientError": {
      "dev-source": "./src/error/ApiClientError.ts",
      "types": "./lib/error/ApiClientError.d.ts",
      "default": "./lib/error/ApiClientError.js"
    },
    "./error/BackendError": {
      "dev-source": "./src/error/BackendError.ts",
      "types": "./lib/error/BackendError.d.ts",
      "default": "./lib/error/BackendError.js"
    },
    "./error/CacheError": {
      "dev-source": "./src/error/CacheError.ts",
      "types": "./lib/error/CacheError.d.ts",
      "default": "./lib/error/CacheError.js"
    },
    "./error/CustomError": {
      "dev-source": "./src/error/CustomError.ts",
      "types": "./lib/error/CustomError.d.ts",
      "default": "./lib/error/CustomError.js"
    },
    "./error/DatabaseError": {
      "dev-source": "./src/error/DatabaseError.ts",
      "types": "./lib/error/DatabaseError.d.ts",
      "default": "./lib/error/DatabaseError.js"
    },
    "./error/EnvironmentNotSetError": {
      "dev-source": "./src/error/EnvironmentNotSetError.ts",
      "types": "./lib/error/EnvironmentNotSetError.d.ts",
      "default": "./lib/error/EnvironmentNotSetError.js"
    }
  },
  "typesVersions": {
    "*": {
      "config/Config": [
        "./lib/config/Config.d.ts"
      ],
      "config/BackendConfig": [
        "./lib/config/BackendConfig.d.ts"
      ],
      "error/ApiClientError": [
        "./lib/error/ApiClientError.d.ts"
      ],
      "error/BackendError": [
        "./lib/error/BackendError.d.ts"
      ],
      "error/CacheError": [
        "./lib/error/CacheError.d.ts"
      ],
      "error/CustomError": [
        "./lib/error/CustomError.d.ts"
      ],
      "error/DatabaseError": [
        "./lib/error/DatabaseError.d.ts"
      ],
      "error/EnvironmentNotSetError": [
        "./lib/error/EnvironmentNotSetError.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "pretest": "npm run check",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint:check",
    "check:write": "npm run lint && npm run format",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:check": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
