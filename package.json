{
  "name": "budgetbuddyde",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "waku": "1.0.0-rc.1",
    "fumapress": {
      "waku": "1.0.0-rc.1"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/webapp",
    "apps/documentation",
    "examples/*"
  ],
  "scripts": {
    "prepare": "vp config --no-agent",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev-services": "turbo run dev --filter=./services/*",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint && vp lint vite.config.ts vite.shared.ts ci/tests/*.mjs --fix --max-warnings=0",
    "lint:check": "turbo run lint:check && vp lint vite.config.ts vite.shared.ts ci/tests/*.mjs --max-warnings=0",
    "check": "turbo run check",
    "check:write": "turbo run check:write",
    "test": "turbo run test",
    "build": "turbo run build",
    "build-packages": "turbo run build --filter=./packages/*",
    "build-services": "turbo run build --filter=./services/*",
    "build-apps": "turbo run build --filter=./apps/*",
    "build-examples": "turbo run build --filter='./examples/*'",
    "typecheck": "turbo run typecheck",
    "ci": "npm run format:check && npm run lint:check && npm run typecheck && npm run test:ci-contracts && npm test && npm run build",
    "test:ci-contracts": "node --test ci/tests/*.test.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
